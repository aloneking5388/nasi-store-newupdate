{
  "name": "api-gateway",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/api-gateway/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node services/api-gateway/server.js"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check services/api-gateway/server.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.log('No tests configured for api-gateway yet')\""
      }
    }
  },
  "tags": ["scope:service"]
}
