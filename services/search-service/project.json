{
  "name": "search-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/search-service/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node services/search-service/src/index.js"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check services/search-service/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node -e \"console.log('No tests configured for search-service yet')\""
      }
    }
  },
  "tags": ["scope:service"]
}


