{
  "name": "auth-service",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "services/auth-service/src",
  "projectType": "application",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node services/auth-service/src/index.js"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --check services/auth-service/src/index.js"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "node --test services/auth-service/tests/utils/jwt.service.test.js services/auth-service/tests/utils/password.service.test.js services/auth-service/tests/utils/cookie.service.test.js services/auth-service/tests/utils/response.factory.test.js"
      }
    }
  },
  "tags": ["scope:service"]
}


