{
  "name": "nasi-store-mlm-main",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "node server.js",
    "dev:next": "next dev apps/client-web --webpack",
    "dev:turbo": "next dev apps/client-web --turbopack",
    "build": "next build apps/client-web",
    "start": "node server.js --prod",
    "lint": "tsc --noEmit -p apps/client-web/tsconfig.json",
    "nx": "nx",
    "nx:graph": "nx graph",
    "nx:show": "nx show projects",
    "dev:all:web": "nx run-many -t dev --projects=client-web,seller-web,admin-web --parallel=3",
    "build:all:web": "nx run-many -t build --projects=client-web,seller-web,admin-web --parallel=3"
  },
